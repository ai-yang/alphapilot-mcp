{
  "mcpServers": {
    "alphapilot": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/absolute/path/alphapilot-mcp/dist/cli.js",
        "serve",
        "--transport",
        "stdio"
      ],
      "env": {
        "ALPHAPILOT_BASE_URL": "${ALPHAPILOT_BASE_URL}",
        "ALPHAPILOT_RESEARCH_TOKEN": "${ALPHAPILOT_RESEARCH_TOKEN}"
      }
    }
  }
}
